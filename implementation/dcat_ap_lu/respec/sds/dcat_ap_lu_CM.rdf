  <rdf:Description rdf:about="https://mindig_lu.gitlab.io/DCAT-AP-LU#core">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="https://data.europa.eu/m8g"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
    <dcterms:title xml:lang="en">DCAT-AP-LU 1.1.0</dcterms:title>
    <rdfs:label xml:lang="en">This artefact provides the definitions for the DCAT-AP-LU.
        This artefact excludes the restrictions.
        The DCAT-AP-LU describes objects and concepts, with definitions, attributes and relationships which are used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency.</rdfs:label>
    <dcterms:description xml:lang="en">This artefact provides the definitions for the DCAT-AP-LU.
        This artefact excludes the restrictions.
        DCAT-AP-LU is a Luxembourg-specific extension of the DCAT-AP profile used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe. It was created as part of the national implementation of the Data Governance Act (DGA) to support the creation of a single national dataset catalogue for all public sector data. The DCAT-AP-LU reuses large parts of the DCAT-AP-v3.0 standard, with a set of minor adaptations to support specific requirements for Luxembourg.</dcterms:description>
    <dcterms:publisher>https://mindig_lu.gitlab.io/DCAT-AP-LU</dcterms:publisher>
    <rdfs:comment>This version is automatically generated from dcat_ap_lu_CM.xml on 2026-02-27</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://mindig_lu.gitlab.io/DCAT-AP-LU/"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-27</dcterms:issued>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-15</dcterms:created>
    <owl:versionInfo>1.1.0</owl:versionInfo>
    <owl:incompatibleWith></owl:incompatibleWith>
    <owl:versionIRI rdf:resource="https://mindig_lu.gitlab.io/DCAT-AP-LU#core-1.1.0"/>
    <owl:priorVersion>https://mindig_lu.gitlab.io/DCAT-AP-LU#core-1.0.0</owl:priorVersion>
    <vann:preferredNamespaceUri>https://mindig_lu.gitlab.io/DCAT-AP-LU/#</vann:preferredNamespaceUri>
    <vann:preferredNamespacePrefix>dal</vann:preferredNamespacePrefix>
    <dcterms:license>Copyright 2025 Ministère de la Digitalisation, Luxembourg. All material in this repository is published under the license CC-BY 4.0, unless explicitly otherwise mentioned.</dcterms:license>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#accessURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">access URL</skos:prefLabel>
    <skos:definition xml:lang="en">A URL that gives access to a Distribution of the Dataset. (dcat:Distribution)</skos:definition>
    <dcterms:references xml:lang="en">&lt;a href="https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_access_url"&gt;Link&lt;/a&gt;</dcterms:references>
    <reuse xml:lang="en">&lt;a href="https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Distribution.accessURL"&gt;A&lt;/a&gt;</reuse>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Dataset</skos:prefLabel>
    <skos:definition xml:lang="en">A conceptual entity that represents the information published.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">title</skos:prefLabel>
    <skos:definition xml:lang="en">A name given to the Dataset (dcat:Dataset)</skos:definition>
    <reuse xml:lang="en">&lt;a href="https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.title"&gt;A&lt;/a&gt;</reuse>
    <dcterms:references xml:lang="en">&lt;a href="https://www.w3.org/TR/vocab-dcat-3/#Property:resource_title"&gt;Link&lt;/a&gt;</dcterms:references>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#distribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">distribution</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dataset distribution</skos:prefLabel>
    <skos:definition xml:lang="en">An available Distribution for the Dataset.</skos:definition>
    <reuse xml:lang="en">&lt;a href="https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.datasetdistribution"&gt;A&lt;/a&gt;</reuse>
    <dcterms:references xml:lang="en">&lt;a href="https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_distribution"&gt;Link&lt;/a&gt;</dcterms:references>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#Literal">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <skos:prefLabel xml:lang="en">Literal</skos:prefLabel>
    <skos:definition xml:lang="en">A literal value such as a string or integer. Literals may be typed, e.g. as a date according to xsd:date. Literals that contain human-readable text have an optional language tag as defined by BCP 4715 [[RFC5646]].</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Distribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Distribution</skos:prefLabel>
    <skos:definition xml:lang="en">A physical embodiment of the Dataset in a particular format.</skos:definition>
  </rdf:Description>
