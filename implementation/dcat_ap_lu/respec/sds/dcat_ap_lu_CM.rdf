  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">description</skos:prefLabel>
    <skos:definition xml:lang="en">A free-text account of the Dataset. (dcat:Dataset)</skos:definition>
    <reuse xml:lang="en">&lt;a href="https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.description"&gt;A&lt;/a&gt;</reuse>
