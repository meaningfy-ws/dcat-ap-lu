  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#keyword">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">keyword</skos:prefLabel>
    <skos:definition xml:lang="en">A keyword or tag describing the Dataset. (dcat:Dataset)</skos:definition>
    <dcterms:references xml:lang="en">&lt;a href="https://www.w3.org/TR/vocab-dcat-3/#Property:resource_landing_page"&gt;Link&lt;/a&gt;</dcterms:references>
