@prefix core-res: <https://mindig_lu.gitlab.io/DCAT-AP-LU#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcat:distribution rdfs:domain dcat:Dataset ;
    rdfs:range dcat:Distribution .

dcat:keyword rdfs:domain dcat:Dataset ;
    rdfs:range rdfs:Literal .

core-res:core-restriction a owl:Ontology ;
    rdfs:label """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eDCAT-AP-LU describes objects and concepts, with definitions, attributes and relationships which are used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-12-15"^^xsd:date ;
    dcterms:description """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The DCAT-AP-LU describes objects and concepts, with definitions, attributes and relationships which are used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2026-02-27"^^xsd:date ;
    dcterms:license "Copyright 2025 Ministère de la Digitalisation, Luxembourg. All material in this repository is published under the license CC-BY 4.0, unless explicitly otherwise mentioned." ;
    dcterms:publisher "https://mindig_lu.gitlab.io/DCAT-AP-LU" ;
    dcterms:title "DCAT-AP-LU restrictions"@en ;
    vann:preferredNamespacePrefix "dal" ;
    vann:preferredNamespaceUri "https://mindig_lu.gitlab.io/DCAT-AP-LU/#" ;
    rdfs:comment """This version is automatically generated from dcat_ap_lu_CM.xml on 
                2026-02-27""" ;
    rdfs:seeAlso <https://mindig_lu.gitlab.io/DCAT-AP-LU/> ;
    owl:imports dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g>,
        core-res:core ;
    owl:incompatibleWith "" ;
    owl:priorVersion "https://mindig_lu.gitlab.io/DCAT-AP-LU#core-restriction-1.0.0" ;
    owl:versionIRI core-res:core-restriction-1.1.0 ;
    owl:versionInfo "1.1.0" .

dcterms:description rdfs:domain dcat:Dataset ;
    rdfs:range rdfs:Literal .

dcterms:title rdfs:domain dcat:Dataset ;
    rdfs:range rdfs:Literal .

dcat:accessURL rdfs:domain dcat:Distribution ;
    rdfs:range rdfs:Resource .

dcat:Distribution rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality 1 ;
            owl:onDataRange rdfs:Resource ;
            owl:onProperty dcat:accessURL ] .

dcat:Dataset rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality 1 ;
            owl:onDataRange rdfs:Literal ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality 1 ;
            owl:onDataRange rdfs:Literal ;
            owl:onProperty dcterms:description ] .

