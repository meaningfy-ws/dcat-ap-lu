@prefix : <https://mindig_lu.gitlab.io/DCAT-AP-LU/#> .
@prefix core-res: <https://mindig_lu.gitlab.io/DCAT-AP-LU#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_description\">Link</a>"@en ;
    skos:definition "A free-text account of the Dataset. (dcat:Dataset)"@en ;
    skos:prefLabel "description"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.description\">A</a>"@en .

dcterms:title a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_title\">Link</a>"@en ;
    skos:definition "A name given to the Dataset (dcat:Dataset)"@en ;
    skos:prefLabel "title"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.title\">A</a>"@en .

rdfs:Literal a rdfs:Datatype ;
    skos:definition "A literal value such as a string or integer. Literals may be typed, e.g. as a date according to xsd:date. Literals that contain human-readable text have an optional language tag as defined by BCP 4715 [[RFC5646]]."@en ;
    skos:prefLabel "Literal"@en .

rdfs:Resource a rdfs:Datatype ;
    skos:prefLabel "Resource"@en .

dcat:Dataset a owl:Class ;
    skos:definition "A conceptual entity that represents the information published."@en ;
    skos:prefLabel "Dataset"@en .

dcat:Distribution a owl:Class ;
    skos:definition "A physical embodiment of the Dataset in a particular format."@en ;
    skos:prefLabel "Distribution"@en .

dcat:accessURL a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_access_url\">Link</a>"@en ;
    skos:definition "A URL that gives access to a Distribution of the Dataset. (dcat:Distribution)"@en ;
    skos:prefLabel "access URL"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Distribution.accessURL\">A</a>"@en .

dcat:distribution a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_distribution\">Link</a>"@en ;
    skos:definition "An available Distribution for the Dataset."@en ;
    skos:prefLabel "dataset distribution"@en,
        "distribution"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.datasetdistribution\">A</a>"@en .

dcat:keyword a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_landing_page\">Link</a>"@en ;
    skos:definition "A keyword or tag describing the Dataset. (dcat:Dataset)"@en ;
    skos:prefLabel "keyword"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#Dataset.keyword\">A</a>"@en .

core-res:core a owl:Ontology ;
    rdfs:label """This artefact provides the definitions for the DCAT-AP-LU.
        This artefact excludes the restrictions.
        The DCAT-AP-LU describes objects and concepts, with definitions, attributes and relationships which are used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-12-15"^^xsd:date ;
    dcterms:description """This artefact provides the definitions for the DCAT-AP-LU.
        This artefact excludes the restrictions.
        DCAT-AP-LU is a Luxembourg-specific extension of the DCAT-AP profile used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe. It was created as part of the national implementation of the Data Governance Act (DGA) to support the creation of a single national dataset catalogue for all public sector data. The DCAT-AP-LU reuses large parts of the DCAT-AP-v3.0 standard, with a set of minor adaptations to support specific requirements for Luxembourg."""@en ;
    dcterms:issued "2026-02-27"^^xsd:date ;
    dcterms:license "Copyright 2025 Ministère de la Digitalisation, Luxembourg. All material in this repository is published under the license CC-BY 4.0, unless explicitly otherwise mentioned." ;
    dcterms:publisher "https://mindig_lu.gitlab.io/DCAT-AP-LU" ;
    dcterms:title "DCAT-AP-LU 1.1.0"@en ;
    vann:preferredNamespacePrefix "dal" ;
    vann:preferredNamespaceUri "https://mindig_lu.gitlab.io/DCAT-AP-LU/#" ;
    rdfs:comment "This version is automatically generated from dcat_ap_lu_CM.xml on 2026-02-27" ;
    rdfs:seeAlso <https://mindig_lu.gitlab.io/DCAT-AP-LU/> ;
    owl:imports dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "" ;
    owl:priorVersion "https://mindig_lu.gitlab.io/DCAT-AP-LU#core-1.0.0" ;
    owl:versionIRI core-res:core-1.1.0 ;
    owl:versionInfo "1.1.0" .

