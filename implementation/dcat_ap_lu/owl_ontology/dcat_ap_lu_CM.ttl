@prefix : <https://mindig_lu.gitlab.io/DCAT-AP-LU/#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix at-voc: <http://publications.europa.eu/resource/authority/> .
@prefix cfg: <http://www.example.org/stereo#> .
@prefix core-res: <https://mindig_lu.gitlab.io/DCAT-AP-LU#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eli:LegalResource a owl:Class ;
    skos:definition "This class represents the legislation, policy or policies that lie behind the Rules that govern the service."@en ;
    skos:example """Link to web page is: <a href="https://op.europa.eu/web/eu-vocabularies/dataset/-/resource?uri=http://publications.
europa.eu/resource/dataset/eli">here</a>."""@en ;
    skos:note "The definition and properties of the Legal Resource class are aligned with the ontology included in \"Council conclusions inviting the introduction of the European Legislation Identifier (<a href=\"https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A52012XG1026%2801%29\">ELI</a>). For describing the attributes of a Legal Resource"@en ;
    skos:prefLabel "Legal Resource"@en ;
    skos:scopeNote "(labels, preferred labels, alternative labels, definition, etc.) we refer to the ELI ontology. In this data specification,  the use is restricted to instances of this class that follow the ELI URI guidelines."@en .

dcatap:applicableLegislation a owl:ObjectProperty ;
    skos:definition "The legislation that mandates the creation or management of the Dataset. The legislation that mandates the creation or management of the Dataset Series."@en ;
    skos:note "DCAT-AP-LU provides additional usage <a href=\"#legislation_guidance\">guidance for this property</a> in the [[DGA]] context."@en ;
    skos:prefLabel "applicable Legislation"@en,
        "applicable legislation"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.applicablelegislation\">E</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DatasetSeries.applicablelegislation\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.applicablelegislation\">A</a>"@en .

dcatap:availability a owl:ObjectProperty ;
    skos:definition "An indication how long it is planned to keep the Distribution of the Dataset available."@en ;
    skos:prefLabel "availability"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.availability\">A</a>"@en .

dcterms:Frequency a owl:Class ;
    skos:definition "A rate at which something recurs, e.g. the publication of a Dataset."@en ;
    skos:prefLabel "Frequency"@en ;
    :vocabname "EU Vocabularies Frequency Named Authority List"@en,
        "Frequency - EU Vocabularies -Publications Office of the EU"@en ;
    :vocaburi "https://publications.europa.eu/resource/authority/file-type"@en,
        "https://publications.europa.eu/resource/authority/frequency"@en .

dcterms:LicenseDocument a owl:Class ;
    skos:definition "A legal document giving official permission to do something with a resource."@en ;
    skos:prefLabel "License Document"@en ;
    :vocabname "ADMS licence type vocabulary"@en ;
    :vocaburi "http://purl.org/adms/licencetype/1.0"@en .

dcterms:LinguisticSystem a owl:Class ;
    skos:definition "A system of signs, symbols, sounds, gestures, or rules used in communication, e.g. a language."@en ;
    skos:prefLabel "Linguistic System"@en ;
    :vocabname "EU Vocabularies Languages Named Authority List"@en ;
    :vocaburi "https://publications.europa.eu/resource/authority/language"@en .

dcterms:Location a owl:Class ;
    skos:definition "A temporal period that the Dataset covers."@en ;
    skos:prefLabel "Location"@en .

dcterms:MediaType a owl:Class ;
    skos:definition "A file format or physical medium."@en ;
    skos:prefLabel "Media Type"@en ;
    :vocabname "File type - EU Vocabularies - Publications Office of the EU."@en,
        "IANA Media Types"@en ;
    :vocaburi "https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/file-type"@en,
        "https://www.iana.org/assignments/media-types/media-types.xhtml"@en .

dcterms:MediaTypeOrExtent a owl:Class ;
    skos:definition "A media type or dataset distribution."@en ;
    skos:prefLabel "Media Type Or Extent"@en,
        "Media type or extent"@en ;
    :vocabname "EU Vocabularies File Type Named Authority List"@en ;
    :vocaburi "http://publications.europa.eu/resource/authority/file-type"@en .

dcterms:PeriodOfTime a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#PeriodofTime\">Link</a>"@en ;
    skos:definition "An interval of time that is named or defined by its start and end dates."@en ;
    skos:prefLabel "Period Of Time"@en,
        "Period of time"@en .

dcterms:ProvenanceStatement a owl:Class ;
    skos:definition "A statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
    skos:prefLabel "Provenance Statement"@en .

dcterms:RightsStatement a owl:Class ;
    skos:definition "A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en ;
    skos:prefLabel "Rights Statement"@en ;
    :vocabname "Access Rights Named Authority List"@en,
        "Access right - EU Vocabularies - Publications Office of the EU"@en ;
    :vocaburi "https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/access-right"@en,
        "https://publications.europa.eu/resource/authority/access-right"@en .

dcterms:Standard a owl:Class ;
    skos:definition "A standard or other specification to which a Dataset or Distribution conforms."@en ;
    skos:prefLabel "Standard"@en .

dcterms:accrualPeriodicity a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_frequency\">Link</a>"@en ;
    skos:definition "The frequency at which the Dataset is updated."@en ;
    skos:prefLabel "accrual Periodicity"@en,
        "frequency"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.frequency\">A</a>"@en .

dcterms:conformsTo a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_conforms_to\">Link</a>"@en,
        "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_conforms_to\">Link</a>"@en ;
    skos:definition "An implementing rule or other specification. An established schema to which the described Distribution conforms."@en ;
    skos:prefLabel "conforms To"@en,
        "conforms to"@en,
        "linked schemas"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.conformsto\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.linkedschemas\">A</a>"@en .

dcterms:creator a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_creator\">Link</a>"@en ;
    skos:definition "An entity responsible for the creation of the catalogue. An entity responsible for producing the dataset."@en ;
    skos:prefLabel "creator"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Catalogue.creator\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.creator\">A</a>"@en .

dcterms:description a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_description\">Link</a>"@en ;
    skos:definition "A free-text account of the Dataset. (dcat:Dataset) A free-text account of the Distribution. (dcat:Distribution)"@en ;
    skos:note "This property can be repeated for parallel language versions of the description."@en ;
    skos:prefLabel "description"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.description\">A</a>"@en .

dcterms:format a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_format\">Link</a>"@en ;
    skos:definition "The file format of the Distribution."@en ;
    skos:note "DCAT-AP-LU provides <a href=\"#format_guidance\">additional usage guidance</a> on the use of this property for expressing data use restrictions."@en ;
    skos:prefLabel "format"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.format\">E</a>"@en .

dcterms:identifier a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_identifier\">Link</a>"@en ;
    skos:definition "The main identifier for the Dataset, e.g. the URI or other unique identifier in the context of the Catalogue. (dcat:Dataset)"@en ;
    skos:note "The use of persistent dereferenceable URIs is mandatory in this profile."@en ;
    skos:prefLabel "identifier"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.identifier\">E</a>"@en .

dcterms:isReferencedBy a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_is_referenced_by\">Link</a>"@en ;
    skos:definition "A related resource, such as a publication, that references, cites, or otherwise points to the dataset. (dcat:Dataset)"@en ;
    skos:prefLabel "is Referenced By"@en,
        "is referenced by"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.isreferencedby\">A</a>"@en .

dcterms:issued a rdf:Property ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_release_date\">Link</a>"@en ;
    skos:definition "The date of formal issuance (e.g., publication) of the Dataset. (dcat:Dataset) The date of formal issuance (e.g., publication) of the Distribution. (dcat:Distribution)"@en ;
    skos:prefLabel "issued"@en,
        "release date"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.releasedate\">A</a>"@en .

dcterms:language a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_language\">Link</a>"@en ;
    skos:definition "A language of the Dataset. A language used in the Distribution."@en ;
    skos:note "This property can be repeated if the metadata is provided in multiple languages."@en,
        "This property can be repeated if there are multiple languages in the Dataset."@en ;
    skos:prefLabel "language"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.language\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.language\">A</a>"@en .

dcterms:license a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/licence\">Link</a>"@en ;
    skos:definition "A licence under which the Catalogue can be used or reused. A licence under which the Distribution is made available."@en ;
    skos:note "Licence object should only come from <a href=\"https://op.europa.eu/en/web/eu-vocabularies/concept-scheme/-/resource?uri=http://publications.europa.eu/resource/authority/licence\">Licence - EU Vocabularies - Publications Office of the EU</a>."@en ;
    skos:prefLabel "licence"@en,
        "license"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Catalogue.licence\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.licence\">A</a>"@en .

dcterms:modified a rdf:Property ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_update_date\">Link</a>"@en ;
    skos:definition "The most recent date on which the Dataset was changed or modified. (dcat:Dataset) The most recent date on which the Distribution was changed or modified. (dcat:Distribution)"@en ;
    skos:prefLabel "modification date"@en,
        "modified"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.modificationdate\">A</a>"@en .

dcterms:provenance a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#dereferenceable-identifiers\">Link</a>"@en ;
    skos:definition "A statement about the lineage of a Dataset."@en ;
    skos:note "DCAT-AP-LU recommends the use of this property. Refer to usage guidance for details."@en ;
    skos:prefLabel "provenance"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.provenance\">E</a>"@en .

dcterms:publisher a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_publisher\">Link</a>"@en ;
    skos:definition "An entity (organisation) responsible for making the Catalogue available. An entity (organisation) responsible for making the Dataset available."@en ;
    skos:note "DCAT-AP-LU provides additional usage guidance regarding vocabularies for publishers."@en,
        "In case multiple organisations are considered the publishers of the catalogue, it is recommended to use foaf:Group to bundle them into one entity."@en ;
    skos:prefLabel "publisher"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Catalogue.publisher\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.publisher\">E</a>"@en,
        "<a href=https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DatasetSeries.publisher\">A</a>"@en .

dcterms:relation a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_relation\">Link</a>"@en ;
    skos:definition "A related resource. (dcat:Dataset)"@en ;
    skos:prefLabel "related resource"@en,
        "relation"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.relatedresource\">A</a>"@en .

dcterms:rights a owl:ObjectProperty ;
    dcterms:references """<a href="https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_rights">Link</a>
"""@en,
        "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_access_rights\">Link</a>"@en ;
    skos:definition "Information that indicates whether the Dataset is publicly accessible, has access restrictions, or is not public. A statement that specifies rights associated with the Distribution."@en ;
    skos:note "DCAT-AP-LU places additional restrictions on the vocabularies recommended in DCAT-AP. See section <a href=\"#controlled-vocs\">10. Controlled Vocabularies</a> for details."@en ;
    skos:prefLabel "access rights"@en,
        "rights"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.accessrights\">E</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.rights\">A</a>"@en .

dcterms:source a owl:ObjectProperty ;
    skos:definition "A related Dataset from which the described Dataset is derived."@en ;
    skos:prefLabel "source"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.source\">A</a>"@en .

dcterms:spatial a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.geographicalcoverage\">E</a>"@en,
        "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_spatial\">Link</a>"@en ;
    skos:definition "A geographic region that is covered by the Dataset. A geographic region that is covered by the Dataset Series"@en ;
    skos:note "When spatial coverage is a dimension in the dataset series then the spatial coverage of each dataset in the collection should be part of the spatial coverage. In that case, an open ended value is recommended,"@en ;
    skos:prefLabel "geographical coverage"@en,
        "spatial"@en ;
    skos:scopeNote "e.g. EU or a broad bounding box covering the expected values."@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.geographicalcoverage\">A</a>"@en,
        "<a href=https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DatasetSeries.geographicalcoverage\">A</a>"@en .

dcterms:temporal a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_temporal\">Link</a>"@en ;
    skos:definition "A temporal period that the Dataset covers."@en ;
    skos:prefLabel "temporal"@en,
        "temporal coverage"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.temporalcoverage\">A</a>"@en .

dcterms:title a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_title\">Link</a>"@en ;
    skos:definition "A name given to the Dataset (dcat:Dataset) A name given to the Distribution. (dcat:Distribution)"@en ;
    skos:note "This property can be repeated for parallel language versions of the name."@en ;
    skos:prefLabel "title"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.title\">A</a>"@en .

dcterms:type a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_type\">Link</a>"@en ;
    skos:definition "A type of the Dataset. A type of licence, e.g. indicating 'public domain' or 'royalties required'."@en ;
    skos:note "DCAT-AP-LU extends the recommendations for controlled vocabularies for this property provided by DCAT-AP."@en ;
    skos:prefLabel "type"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.type\">E</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#LicenceDocument.type\">A</a>"@en .

spdx:Checksum a owl:Class ;
    skos:definition "A Checksum is value that allows the contents of a file to be authenticated. Even small changes to the content of the file will change its checksum. This class allows the results of a variety of checksum and cryptographic message digest algorithms to be represented."@en ;
    skos:prefLabel "Checksum"@en .

spdx:checksum a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_checksum\">Link</a>"@en ;
    skos:definition "A mechanism that can be used to verify that the contents of a distribution have not changed."@en ;
    skos:note "The checksum is related to the download URL"@en ;
    skos:prefLabel "checksum"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.checksum\">A</a>"@en .

skos:Concept a owl:Class ;
    skos:definition "An idea or notion; a unit of thought."@en ;
    skos:prefLabel "Concept"@en ;
    :vocabname "Data theme - EU Vocabularies - Publications Office of the EU"@en,
        "Dataset Theme Vocabulary"@en,
        "Distribution availability vocabulary"@en,
        "EU Vocabularies Distribution Status"@en ;
    :vocaburi "https://publications.europa.eu/resource/authority/data-theme"@en,
        "https://publications.europa.eu/resource/authority/distribution-status"@en,
        "https://publications.europa.eu/resource/authority/planned-availability"@en .

skos:prefLabel a owl:DatatypeProperty ;
    skos:note "This property can be repeated for parallel language versions of the label."@en ;
    skos:prefLabel "pref Label"@en,
        "preferred label"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Concept.preferredlabel\">A</a>"@en .

time:hasBeginning a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:period_has_beginning\">Link</a>"@en ;
    skos:definition "The beginning of a period or interval. (dct:PeriodOfTime)"@en ;
    skos:prefLabel "beginning"@en,
        "has Beginning"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#PeriodofTime.beginning\">A</a>"@en .

time:hasEnd a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:period_has_end\">Link</a>"@en ;
    skos:definition "The end of a period or interval. (dct:PeriodOfTime)"@en ;
    skos:prefLabel "end"@en,
        "has End"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#PeriodofTime.end\">A</a>"@en .

vcard:Kind a owl:Class ;
    skos:definition "A description following the vCard specification, e.g. to provide telephone number and e-mail address for a contact point."@en ;
    skos:note "Note that the class Kind is the parent class for the four explicit types of <a href=\"https://www.rfc-editor.org/rfc/rfc6350.html\">vCard</a> (Individual, Organization, Location, Group)."@en ;
    skos:prefLabel "Kind"@en .

adms:Identifier a owl:Class ;
    skos:definition "This is based on the UN/CEFACT Identifier class."@en ;
    skos:prefLabel "Identifier"@en .

adms:identifier a owl:ObjectProperty ;
    dcterms:references "<a href =\"https://www.w3.org/TR/vocab-dcat-3/#dereferenceable-identifiers\">Link</a>"@en ;
    skos:definition "A secondary identifier of the Dataset."@en ;
    skos:note "Examples are MAST/ADS [[MASTADS]], DOI [[DOI]], EZID [[EZID]] or W3ID [[W3ID]]."@en ;
    skos:prefLabel "identifier"@en,
        "other identifier"@en ;
    :reuse "<a href=\"semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.otheridentifier\">A</a>"@en .

adms:identifierX a owl:ObjectProperty ;
    dcterms:references "<a href =\"https://www.w3.org/TR/vocab-dcat-3/#dereferenceable-identifiers\">Link</a>"@en ;
    skos:definition "A secondary identifier of the Dataset."@en ;
    skos:note "Examples are MAST/ADS [[MASTADS]], DOI [[DOI]], EZID [[EZID]] or W3ID [[W3ID]]."@en ;
    skos:prefLabel "identifier X"@en,
        "other identifier"@en ;
    :reuse "<a href=\"semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.otheridentifier\">A</a>"@en .

adms:sample a owl:ObjectProperty ;
    skos:definition "A sample distribution of the dataset."@en ;
    skos:note """DCAT-AP-LU provides <a href="#sample_guidance">additional usage guidance</a> for the use of this property in providing data dictionaries as part of dataset descriptions.
"""@en ;
    skos:prefLabel "sample"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.sample\">E</a>"@en .

adms:status a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_status\">Link</a>"@en ;
    skos:definition "The status of the distribution in the context of maturity lifecycle."@en ;
    skos:note "It MUST take one of the values Completed, Deprecated, Under Development, Withdrawn."@en ;
    skos:prefLabel "status"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.status\">A</a>"@en .

adms:versionNotes a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_version_notes\">Link</a>"@en ;
    skos:definition "A description of the differences between this version and a previous version of the Dataset. (dcat:Dataset)"@en ;
    skos:note "This property can be repeated for parallel language versions of the version notes."@en ;
    skos:prefLabel "version Notes"@en,
        "version notes"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.versionnotes\">A</a>"@en .

dcat:Catalog a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Catalogue\">Link</a>"@en ;
    skos:definition "A catalogue or repository that hosts the Datasets or Data Services being described."@en ;
    skos:prefLabel "Catalog"@en,
        "Catalogue"@en .

dcat:CatalogRecord a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#CatalogueRecord\">Link</a>"@en ;
    skos:definition "A description of a Catalogued Resource's entry in the Catalogue."@en ;
    skos:prefLabel "Catalog Record"@en,
        "Catalogue Record"@en .

dcat:DataService a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DataService\">Link</a>"@en ;
    rdfs:subClassOf dcat:Resource ;
    skos:definition "A collection of operations that provides access to one or more datasets or data processing functions."@en ;
    skos:prefLabel "Data Service"@en .

dcat:Dataset a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset\">Link</a>"@en ;
    rdfs:subClassOf dcat:Resource ;
    skos:definition "A conceptual entity that represents the information published."@en ;
    skos:prefLabel "Dataset"@en .

dcat:DatasetSeries a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DatasetSeries\">Link</a>"@en ;
    rdfs:subClassOf dcat:Resource ;
    skos:definition "A collection of datasets that are published separately, but share some characteristics that group them."@en ;
    skos:note "It is recommended to avoid Dataset Series without a dataset in the collection. Therefore at least one Dataset should refer to a Dataset Series using the property in series (dcat:inSeries)."@en ;
    skos:prefLabel "Dataset Series"@en .

dcat:Distribution a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution\">Link</a>"@en ;
    skos:definition "A physical embodiment of the Dataset in a particular format."@en ;
    skos:prefLabel "Distribution"@en .

dcat:Relationship a owl:Class ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Relationship\">Link</a>"@en ;
    skos:definition "An association class for attaching additional information to a relationship between DCAT Resources."@en ;
    skos:prefLabel "Relationship"@en .

dcat:accessService a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_access_service\">Link</a>"@en ;
    skos:definition "A data service that gives access to the distribution of the dataset."@en ;
    skos:prefLabel "access Service"@en,
        "access service"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.accessservice\">A</a>"@en .

dcat:accessURL a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_access_url\">Link</a>"@en ;
    skos:definition "A URL that gives access to a Distribution of the Dataset. (dcat:Distribution)"@en ;
    skos:note "DCAT-AP-LU provides <a href=\"#accessurl_guidance\">additional usage guidance</a> on the use of this property for expressing data use restrictions."@en ;
    skos:prefLabel "access URL"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.accessURL\">E</a>"@en .

dcat:byteSize a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_size\">Link</a>"@en ;
    skos:definition "The size of a Distribution in bytes. (dcat:Distribution)"@en ;
    skos:note "DCAT-AP-LU provides <a href=\"#bytesize_guidance\">additional usage guidance</a> on the use of this property for expressing data use restrictions."@en ;
    skos:prefLabel "byte Size"@en,
        "byte size"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.bytesize\">E</a>"@en .

dcat:compressFormat a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_compression_format\">Link</a>"@en ;
    skos:definition "compressed form, e.g. to reduce the size of the downloadable file."@en ;
    skos:note "It SHOULD be expressed using a media type as defined in the official register of media types managed by <a href=\"https://www.iana.org/\">IANA</a>."@en ;
    skos:prefLabel "compress Format"@en,
        "compression format"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.compressionformat\">A</a>"@en .

dcat:contactPoint a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_contact_point\">Link</a>"@en ;
    skos:definition "Contact information that can be used for sending comments about the Dataset. Contact information that can be used for sending comments about the DatasetSeries."@en ;
    skos:prefLabel "contact Point"@en,
        "contact point"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.contactpoint\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DatasetSeries.contactpoint\">A</a>"@en .

dcat:distribution a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_distribution\">Link</a>"@en ;
    skos:definition "An available Distribution for the Dataset."@en ;
    skos:prefLabel "dataset distribution"@en,
        "distribution"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.datasetdistribution\">E</a>"@en .

dcat:downloadURL a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_download_url\">Link</a>"@en ;
    skos:definition "A URL that is a direct link to a downloadable file in a given format. (dcat:Distribution)"@en ;
    skos:prefLabel "download URL"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.downloadURL\">A</a>"@en .

dcat:endDate a rdf:Property ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:period_end_date\">Link</a>"@en ;
    skos:definition "The end of the period. (dct:PeriodOfTime)"@en ;
    skos:prefLabel "end Date"@en,
        "end date"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#PeriodofTime.enddate\">A</a>"@en .

dcat:hasVersion a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_has_version\">Link</a>"@en ;
    skos:definition "A related Dataset that is a version, edition, or adaptation of the described Dataset."@en ;
    skos:prefLabel "has Version"@en,
        "has version"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.hasversion\">A</a>"@en .

dcat:inSeries a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_in_series\">Link</a>"@en ;
    skos:definition "A dataset series of which the dataset is part."@en ;
    skos:note "DCAT-AP-LU recommends the use of DatasetSeries, with additional guidance provided."@en ;
    skos:prefLabel "in Series"@en,
        "in series"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.inseries\">E</a>"@en .

dcat:keyword a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_landing_page\">Link</a>"@en ;
    skos:definition "A keyword or tag describing the Dataset. (dcat:Dataset)"@en ;
    skos:prefLabel "keyword"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.keyword\">A</a>"@en .

dcat:landingPage a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_landing_page\">Link</a>"@en ;
    skos:definition "A web page that provides access to the Dataset, its Distributions and/or additional information."@en ;
    skos:note "It is intended to point to a landing page at the original data provider, not to a page on a site of a third party, such as an aggregator."@en ;
    skos:prefLabel "landing Page"@en,
        "landing page"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.landingpage\">A</a>"@en .

dcat:mediaType a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_media_type\">Link</a>"@en ;
    skos:note "DCAT-AP-LU provides <a href=\"#usage-guide-on-datasets-and-distributions\">additional usage guidance</a> for this property."@en ;
    skos:prefLabel "media Type"@en,
        "media type"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.mediatype\">E</a>"@en .

dcat:packageFormat a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.packagingformat\">Link</a>"@en ;
    skos:definition "The format of the file in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together."@en ;
    skos:note "It SHOULD be expressed using a media type as defined in the official register of media types managed by <a href=\"https://www.iana.org/\">IANA</a>."@en ;
    skos:prefLabel "package Format"@en,
        "packaging format"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.mediatype\">A</a>"@en .

dcat:qualifiedRelation a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_qualified_relation\">Link</a>"@en ;
    skos:definition "A description of a relationship with another resource."@en ;
    skos:prefLabel "qualified Relation"@en,
        "qualified relation"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.qualifiedrelation\">A</a>"@en .

dcat:record a owl:ObjectProperty ;
    skos:definition "A Catalogue Record that is part of the Catalogue."@en ;
    skos:prefLabel "record"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Catalogue.record\">A</a>"@en .

dcat:servesDataset a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:data_service_serves_dataset\">Link</a>"@en ;
    skos:prefLabel "serves Dataset"@en,
        "serves dataset"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#DataService.servesdataset\">A</a>"@en .

dcat:service a owl:ObjectProperty ;
    skos:definition "A site or end-point (Data Service) that is listed in the Catalogue."@en ;
    skos:note "As empty Catalogues are usually indications of problems, this property should be combined with the property Catalogue.dataset to implement an empty Catalogue check."@en ;
    skos:prefLabel "service"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Catalogue.service\">A</a>"@en .

dcat:spatialResolutionInMeters a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_spatial_resolution\">Link</a>"@en ;
    skos:definition "The minimum spatial separation resolvable in a dataset, measured in metres. (dcat:Dataset) The minimum spatial separation resolvable in a dataset distribution, measured in metres. (dcat:Distribution)"@en ;
    skos:prefLabel "spatial Resolution In Meters"@en,
        "spatial resolution"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.spatialresolution\">A</a>"@en .

dcat:startDate a rdf:Property ;
    skos:definition "The start of the period. (dct:PeriodOfTime)"@en ;
    skos:prefLabel "start Date"@en,
        "start date"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#PeriodofTime.startdate\">A</a>"@en .

dcat:temporalResolution a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_temporal_resolution\">Link</a>"@en ;
    skos:definition "The minimum time period resolvable in the dataset. (dcat:Dataset) The minimum time period resolvable in the dataset distribution. (dcat:Distribution)"@en ;
    skos:prefLabel "temporal Resolution"@en,
        "temporal resolution"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.temporalresolution\">A</a>"@en .

dcat:theme a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_theme\">Link</a>"@en ;
    cfg:usage "testing recommended"@en ;
    skos:definition "A category of the Dataset."@en ;
    skos:note "A Dataset may be associated with multiple themes. Note: the theme is a URI not a URL, and therefore it may not properly resolve in the web browser even though it properly resolves through the API."@en ;
    skos:prefLabel "theme"@en ;
    :reuse "<a href=\"semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.theme\">A</a>"@en .

dcat:version a owl:DatatypeProperty ;
    dcterms:references "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.version\">Link</a>"@en ;
    skos:definition "The version indicator (name or identifier) of a resource. (dcat:Dataset)"@en ;
    skos:prefLabel "version"@en ;
    :reuse "<a href'\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.version\">A</a>"@en .

locn:Geometry a owl:Class ;
    skos:definition "The Geometry class provides the means to identify a Location as a point, line, polygon, etc. expressed using coordinates in some coordinate reference System."@en ;
    skos:prefLabel "Geometry"@en .

locn:geometry a owl:ObjectProperty ;
    skos:prefLabel "geometry"@en .

odrl:Policy a owl:Class ;
    skos:definition "A non-empty group of Permissions and/or Prohibitions."@en ;
    skos:prefLabel "Policy"@en .

odrl:hasPolicy a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_has_policy\">Link</a>"@en ;
    skos:note "DCAT-AP-LU provides <a href=“#policy_guidance”>additional usage guidance</a> on the use of this property for expressing data use restrictions."@en ;
    skos:prefLabel "has Policy"@en,
        "has policy"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.haspolicy\">E</a>"@en .

prov:Activity a owl:Class ;
    skos:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities."@en ;
    skos:prefLabel "Activity"@en .

prov:Attribution a owl:Class ;
    skos:definition "Attribution is the ascribing of an entity to an agent."@en ;
    skos:prefLabel "Attribution"@en .

prov:qualifiedAttribution a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_qualified_attribution\">Link</a>"@en ;
    skos:definition "An Agent having some form of responsibility for the resource."@en ;
    skos:prefLabel "qualified Attribution"@en,
        "qualified attribution"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.qualifiedattribution\">A</a>"@en .

prov:wasGeneratedBy a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:dataset_was_generated_by\">Link</a>"@en ;
    skos:definition "provides the business context for, the creation of the dataset."@en ;
    skos:prefLabel "was Generated By"@en,
        "was generated by"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.wasgeneratedby\">A</a>"@en .

foaf:Agent a owl:Class ;
    skos:definition "Any entity carrying out actions with respect to the entities Catalogue and the Catalogued Resources."@en ;
    skos:prefLabel "Agent"@en ;
    :vocabname "EU Vocabularies Corporate bodies Named Authority List"@en ;
    :vocaburi "https://publications.europa.eu/resource/authority/corporate-body"@en .

foaf:Document a owl:Class ;
    skos:definition "A textual resource intended for human consumption that contains information, e.g. a web page about a Dataset."@en ;
    skos:prefLabel "Document"@en .

foaf:page a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_landing_page\">Link</a>"@en ;
    skos:definition "A page or document about this Dataset. A page or document about this Distribution."@en ;
    skos:prefLabel "documentation"@en,
        "page"@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Dataset.documentation\">A</a>"@en,
        "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#Distribution.documentation\">A</a>"@en .

foaf:primaryTopic a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:record_primary_topic\">Link</a>"@en ;
    skos:definition "A link to the Dataset, Data service or Catalog described in the record."@en ;
    skos:note "A catalogue record will refer to one entity in a catalogue. This can be either a Dataset or a Data Service. To ensure an unambigous reading of the cardinality the range is set to Catalogued Resource."@en ;
    skos:prefLabel "primary Topic"@en,
        "primary topic"@en ;
    skos:scopeNote "However it is not the intent with this range to require the explicit use of the class Catalogued Record. As abstract class, an subclass should be used."@en ;
    :reuse "<a href=\"https://semiceu.github.io/DCAT-AP/releases/3.0.1/#CatalogueRecord.primarytopic\">A</a>"@en .

core-res:core a owl:Ontology ;
    rdfs:label "This artefact provides the definitions for the DCAT-AP-LU.         This artefact excludes the restrictions.         The DCAT-AP-LU describes objects and concepts, with definitions, attributes and relationships which are used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe.         The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."@en ;
    dcterms:created "2026-04-28"^^xsd:date ;
    dcterms:description "This artefact provides the definitions for the DCAT-AP-LU.         This artefact excludes the restrictions.         DCAT-AP-LU is a Luxembourg-specific extension of the DCAT-AP profile used for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe. It was created as part of the national implementation of the Data Governance Act (DGA) to support the creation of a single national dataset catalogue for all public sector data. The DCAT-AP-LU reuses large parts of the DCAT-AP-v3.0 standard, with a set of minor adaptations to support specific requirements for Luxembourg."@en ;
    dcterms:issued "2026-04-28"^^xsd:date ;
    dcterms:license "Copyright 2025 Ministère de la Digitalisation, Luxembourg. All material in this repository is published under the license CC-BY 4.0, unless explicitly otherwise mentioned. " ;
    dcterms:publisher "https://mindig_lu.gitlab.io/DCAT-AP-LU" ;
    dcterms:title "DCAT-AP-LU"@en ;
    vann:preferredNamespacePrefix "dal" ;
    vann:preferredNamespaceUri "https://mindig_lu.gitlab.io/DCAT-AP-LU/#" ;
    rdfs:comment "This version is automatically generated from dcat_ap_lu_CM.xml on 2026-04-28" ;
    rdfs:seeAlso <https://mindig_lu.gitlab.io/DCAT-AP-LU/> ;
    owl:imports cv:,
        dcatap:,
        at-voc:,
        dcmitype:,
        dcterms:,
        spdx:,
        <http://www.opengis.net/ont/geosparql>,
        <http://www.w3.org/2004/02/skos/core>,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/2006/vcard/ns>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/dcat>,
        <http://www.w3.org/ns/locn>,
        odrl:,
        org:,
        <http://www.w3.org/ns/person>,
        prov:,
        foaf:,
        <https://data.europa.eu/m8g/>,
        <https://w3id.org/dpv#> ;
    owl:incompatibleWith "" ;
    owl:priorVersion "https://mindig_lu.gitlab.io/DCAT-AP-LU#core-" ;
    owl:versionIRI core-res:core-1 ;
    owl:versionInfo "1" .

<https://w3id.org/dpv#Data> a owl:Class ;
    skos:definition "A broad concept representing 'data' or 'information'."@en ;
    skos:prefLabel "Data"@en ;
    :vocabname "Data"@en ;
    :vocaburi "https://w3c.github.io/dpv/2.2/dpv/#Data"@en .

<https://w3id.org/dpv#hasData> a owl:ObjectProperty ;
    dcterms:references "<a href=\"https://w3c.github.io/dpv/2.2/dpv/#hasData\">Link</a>"@en ;
    skos:definition "The type(s) of data protection, as defined in the context of the DGA, that applies to the dataset."@en ;
    skos:note "A list of accepted types, based on the Data Privacy Vocabulary, is defined in <a href=\"#controlled-vocs\">10. Controlled Vocabularies</a>. For additional usage guidance, refer to section <a href=\"#usage-guide-on-datasets-and-distributions\">11</a>."@en ;
    skos:prefLabel "data protection type"@en,
        "has Data"@en ;
    :reuse "P"@en .

